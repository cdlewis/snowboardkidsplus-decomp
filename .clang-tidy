Checks: >
  -*,
  readability-redundant-declaration,
  readability-redundant-casting,
  readability-redundant-parentheses,
  misc-include-cleaner,
WarningsAsErrors: ""
HeaderFilterRegex: '(^|/)(src|include)/.*\.h$'
ExcludeHeaderFilterRegex: '(^|/)include/(include_asm\.h|game/io/dat_entries\.h)$'
FormatStyle: "none"
CheckOptions:
  # The PSX headers supply these declarations without a hosted C library.
  - key: misc-include-cleaner.MissingIncludes
    value: false
  - key: misc-include-cleaner.IgnoreHeaders
    value: 'common\.h;decomp/types\.h;include_asm\.h;h>'
